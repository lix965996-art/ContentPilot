APP_NAME=ContentPilot
APP_ENV=dev
APP_TIMEZONE=Asia/Shanghai
# All generated files and local sessions default to project-root/var.
CONTENTPILOT_VAR_DIR=

DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/socialflow?charset=utf8mb4
# Leave empty to use var/db/contentpilot.db.
SQLITE_FALLBACK_URL=

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_DEMO_MODE=false
# Local development keeps registration open. Customer deployments must set false.
ALLOW_REGISTRATION=true
# Admin password on first seed. Required when APP_DEMO_MODE=false; seeding fails without it.
ADMIN_INITIAL_PASSWORD=
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60
# Optional outbound HTTP(S) proxy for platform APIs that are unreachable directly,
# for example http://127.0.0.1:7892. Leave empty to connect directly.
OUTBOUND_HTTP_PROXY=
# Persistent dispatch scanner cadence and per-intent retry cap.
DISPATCH_POLL_SECONDS=15
DISPATCH_MAX_ATTEMPTS=10

UNSPLASH_ACCESS_KEY=
MEDIA_FALLBACK_ENABLED=false
PUBLISH_MODE=manual
# Optional local integrations. Both stay off until an administrator explicitly enables them.
# XHS MCP runs on the same computer and reuses a locally scanned Xiaohongshu session.
EXPERIMENTAL_BROWSER_PUBLISHING_ENABLED=false
# Wechatsync only creates browser-backed drafts and requires its Chrome extension.
WECHATSYNC_CLI_ENABLED=false
WECHAT_BROWSER_PUBLISHING_ENABLED=true
WECHAT_BROWSER_HEADLESS=true
# Leave empty to use var/sessions/wechat; an explicit path is still supported.
WECHAT_BROWSER_PROFILE_ROOT=
XHS_MCP_BASE_URL=http://127.0.0.1:18060/mcp
# Usually leave empty. ContentPilot discovers binaries under var/tools/xiaohongshu-mcp.
XHS_MCP_BINARY_PATH=
TOUTIAO_BROWSER_PUBLISHING_ENABLED=true
TOUTIAO_BROWSER_HEADLESS=true
# Leave empty to use var/sessions/toutiao; an explicit path is still supported.
TOUTIAO_BROWSER_PROFILE_ROOT=
PLATFORM_CREDENTIAL_KEY=replace-with-an-independent-random-secret-at-least-32-characters
WEIBO_API_BASE_URL=https://api.weibo.com
WEIBO_UPLOAD_API_BASE_URL=https://upload.api.weibo.com
X_API_BASE_URL=https://api.x.com
X_OAUTH_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_OAUTH_TOKEN_URL=https://api.x.com/2/oauth2/token
WECHAT_API_BASE_URL=https://api.weixin.qq.com
