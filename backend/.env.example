APP_NAME=ContentPilot
APP_ENV=dev
APP_TIMEZONE=Asia/Shanghai

DATABASE_URL=mysql+pymysql://root:123456@127.0.0.1:3306/socialflow?charset=utf8mb4
SQLITE_FALLBACK_URL=sqlite:///./socialflow.db

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

APP_DEMO_MODE=false
# Local development keeps registration open. Customer deployments must set false.
ALLOW_REGISTRATION=true
# Admin password on first seed. Demo mode falls back to Admin@123456 when empty.
ADMIN_INITIAL_PASSWORD=
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT_SECONDS=60

UNSPLASH_ACCESS_KEY=
MEDIA_FALLBACK_ENABLED=false
PUBLISH_MODE=manual
# Optional local integrations. Both stay off until an administrator explicitly enables them.
# XHS MCP runs on the same computer and reuses a locally scanned Xiaohongshu session.
EXPERIMENTAL_BROWSER_PUBLISHING_ENABLED=false
# Wechatsync only creates browser-backed drafts and requires its Chrome extension.
WECHATSYNC_CLI_ENABLED=false
XHS_MCP_BASE_URL=http://127.0.0.1:18060/mcp
PLATFORM_CREDENTIAL_KEY=replace-with-an-independent-random-secret-at-least-32-characters
WEIBO_API_BASE_URL=https://api.weibo.com
WEIBO_UPLOAD_API_BASE_URL=https://upload.api.weibo.com
X_API_BASE_URL=https://api.x.com
X_OAUTH_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_OAUTH_TOKEN_URL=https://api.x.com/2/oauth2/token
WECHAT_API_BASE_URL=https://api.weixin.qq.com
