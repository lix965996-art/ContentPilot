# Copy this file to .env before running Docker Compose.
CONTENTPILOT_PORT=8080
CONTENTPILOT_API_PORT=8000

# Use long, unique values in a real deployment. Keep MySQL passwords URL-safe.
MYSQL_PASSWORD=changeMeMysql2026
MYSQL_ROOT_PASSWORD=changeMeRoot2026
JWT_SECRET=change-this-to-a-random-secret-with-at-least-32-characters
PLATFORM_CREDENTIAL_KEY=change-this-to-a-different-random-32-character-secret

# Keep production data clean. Set true only when you explicitly need sample content.
APP_DEMO_MODE=false
# Customer deployments keep self-service registration closed; admins create accounts instead.
ALLOW_REGISTRATION=false
# First-boot admin password. Required for customer deployments; demo mode falls back to Admin@123456.
ADMIN_INITIAL_PASSWORD=
MEDIA_FALLBACK_ENABLED=true
PUBLISH_MODE=manual
# Optional local publishing bridges. They are disabled by default.
EXPERIMENTAL_BROWSER_PUBLISHING_ENABLED=false
WECHATSYNC_CLI_ENABLED=false
XHS_MCP_BASE_URL=http://127.0.0.1:18060/mcp
TOUTIAO_BROWSER_PUBLISHING_ENABLED=true
TOUTIAO_BROWSER_HEADLESS=true
# TOUTIAO_BROWSER_PROFILE_ROOT=C:\Users\you\.contentpilot\toutiao
X_API_BASE_URL=https://api.x.com
X_OAUTH_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_OAUTH_TOKEN_URL=https://api.x.com/2/oauth2/token

# Optional: these can also be configured later from the administrator UI.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
UNSPLASH_ACCESS_KEY=
